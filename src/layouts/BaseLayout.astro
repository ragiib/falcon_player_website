---
import "../styles/global.css";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_NAME } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = "/screens/player.webp",
} = Astro.props;

const siteOrigin = Astro.site?.origin ?? "https://falconplayer.app";
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const ogImageURL = new URL(image, siteOrigin).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#0c0b0b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f6f5" media="(prefers-color-scheme: light)" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1080" />
    <meta property="og:image:height" content="2340" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body>
    <a href="#main-content" class="skip-nav">Skip to main content</a>
    <slot />
  </body>
</html>

<style>
  .skip-nav {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 9999;
    padding: 0.5rem 1rem;
    background: var(--color-brand);
    color: #fff;
    font-weight: 700;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    text-decoration: none;
    transition: top 0.1s;
  }

  .skip-nav:focus {
    top: 0;
  }
</style>

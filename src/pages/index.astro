---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import DownloadSection from "../components/DownloadSection.astro";
import BottomBar from "../components/BottomBar.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout>
  <Navbar />
  <main id="main-content">
    <Hero />
    <DownloadSection />
  </main>
  <BottomBar />
  <Footer />
</BaseLayout>

<script>
  import { initHeroPhone } from "../scripts/phone-interactivity";
  import { initDownloadFlow } from "../scripts/download-flow";

  function setup() {
    initHeroPhone();
    initDownloadFlow();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setup);
  } else {
    setup();
  }
</script>

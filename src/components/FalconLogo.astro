---
/**
 * FalconLogo – the real Falcon Player app icon as an inline SVG.
 *
 * Source: C:\falcon_player\app\src\main\res\drawable\ic_launcher_foreground.xml
 * Viewport: 108x108 (same as Android vector – no coordinate rescaling)
 *
 * Props:
 *   size       – width/height in px (default 36)
 *   monochrome – fills everything with currentColor
 *   class      – forwarded className
 *
 * NOTE: Each instance generates a unique gradient ID to prevent SVG gradient
 * ID collisions when multiple logos appear on the same page.
 */
interface Props {
  size?: number;
  monochrome?: boolean;
  class?: string;
}
const { size = 36, monochrome = false, class: className = "" } = Astro.props;

// Unique per-render gradient ID to avoid SVG defs ID collisions
const gradId = `falc-grad-${Math.random().toString(36).slice(2, 9)}`;
---
<svg viewBox="0 0 108 108" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class={className || undefined}>
  {monochrome ? (
    <>
      <path d="M30,34 L48,30 L40,42 L26,42 Z" fill="currentColor" opacity="0.5" />
      <path d="M26,45 L44,43 L36,54 L22,54 Z" fill="currentColor" opacity="0.7" />
      <path d="M28,57 L44,55 L38,66 L24,66 Z" fill="currentColor" opacity="0.4" />
      <path d="M38,30 L74,48 L86,54 L74,60 L38,78 L48,54 Z" fill="currentColor" />
      <path d="M48,35 L86,54 L52,54 Z" fill="currentColor" opacity="0.15" />
      <path d="M52,47 L60,51 L52,54 L54,50 Z" fill="currentColor" opacity="0.9" />
    </>
  ) : (
    <>
      <path d="M30,34 L48,30 L40,42 L26,42 Z" fill="#B3121C" />
      <path d="M26,45 L44,43 L36,54 L22,54 Z" fill="#D81722" />
      <path d="M28,57 L44,55 L38,66 L24,66 Z" fill="#960E16" />
      <defs>
        <linearGradient id={gradId} x1="38" y1="30" x2="86" y2="54" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#FF3843" />
          <stop offset="0.5" stop-color="#E50914" />
          <stop offset="1" stop-color="#B80710" />
        </linearGradient>
      </defs>
      <path d="M38,30 L74,48 L86,54 L74,60 L38,78 L48,54 Z" fill={`url(#${gradId})`} />
      <path d="M48,35 L86,54 L52,54 Z" fill="#FFFFFF" fill-opacity="0.15" />
      <path d="M52,47 L60,51 L52,54 L54,50 Z" fill="#FFFFFF" fill-opacity="0.92" />
      <path d="M48,54 L86,54 L74,60 L48,68 Z" fill="#000000" fill-opacity="0.10" />
    </>
  )}
</svg>

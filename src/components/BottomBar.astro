---
import { APK_URL, VERSION, APK_SIZE_MB } from "../config/site";
import FalconLogo from "./FalconLogo.astro";
---

<div class="mobile-bottom-bar" aria-label="Mobile download action bar">
  <div class="bottom-bar-inner">
    <div class="bottom-bar-meta">
      <span class="bottom-bar-brand">
        <span class="bottom-bar-logo" aria-hidden="true">
          <FalconLogo size={20} />
        </span>
        <span class="bottom-app-name">Falcon Player</span>
      </span>
      <span class="bottom-version">v{VERSION} · {APK_SIZE_MB} MB</span>
    </div>
    <a
      href={APK_URL}
      class="btn btn-primary btn-sm mobile-download-btn"
      data-download-btn
      aria-label="Download Falcon Player APK"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <polyline points="7 10 12 15 17 10" />
        <line x1="12" y1="15" x2="12" y2="3" />
      </svg>
      <span class="btn-label">Download APK</span>
    </a>
  </div>
</div>

<style>
  .mobile-bottom-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 85;
    background-color: var(--color-glass);
    backdrop-filter: blur(18px) saturate(180%);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    border-top: 1px solid var(--color-glass-border);
    padding: var(--space-3) var(--space-4);
    padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.45);
  }

  .bottom-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: 500px;
    margin: 0 auto;
  }

  .bottom-bar-meta {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .bottom-bar-brand {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .bottom-bar-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .bottom-app-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }

  .bottom-version {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .mobile-download-btn {
    flex-shrink: 0;
    padding: 0 var(--space-5);
    min-height: 42px;
  }

  @media (max-width: 900px) {
    .mobile-bottom-bar {
      display: block;
    }
  }
</style>

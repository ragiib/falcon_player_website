---
import { APK_URL, REPO_URL, SITE_NAME } from "../config/site";
import FalconLogo from "./FalconLogo.astro";
---

<header class="navbar-wrapper">
  <nav class="navbar" aria-label="Main Navigation">
    <div class="nav-brand">
      <a href="/" class="brand-link" aria-label={`${SITE_NAME} Home`}>
        <span class="logo-mark" aria-hidden="true">
          <FalconLogo size={36} />
        </span>
        <span class="brand-text">{SITE_NAME}</span>
      </a>
    </div>

    <div class="nav-actions">
      <div class="nav-links">
        <a href="#download" class="nav-link">Install guide</a>
        <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="nav-link nav-link-external">
          GitHub
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="external-icon">
            <path d="M7 17L17 7M17 7H8M17 7V16" />
          </svg>
        </a>
      </div>

      <a href={APK_URL} class="btn btn-primary btn-sm nav-download-btn" data-download-btn aria-label="Download Falcon Player APK">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        <span>Download APK</span>
      </a>
    </div>
  </nav>
</header>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0;
    z-index: 90;
    width: 100%;
    padding: var(--space-3) var(--space-6) 0;
    padding-top: calc(var(--space-3) + env(safe-area-inset-top, 0px));
  }

  .navbar {
    max-width: var(--max-width-nav);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-4) var(--space-2) var(--space-5);
    background-color: var(--color-glass);
    backdrop-filter: blur(18px) saturate(180%);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    border: 1px solid var(--color-glass-border);
    border-radius: var(--radius-full);
    box-shadow: 0 8px 32px -8px rgba(0, 0, 0, 0.4);
    min-height: 56px;
  }

  .nav-brand {
    display: flex;
    align-items: center;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-full);
    transition: opacity var(--transition-fast);
  }

  .brand-link:hover {
    opacity: 0.9;
  }

  .logo-mark {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-text {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: -0.025em;
    color: var(--color-ink);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-muted);
    min-height: 44px;
    padding: 0 var(--space-2);
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-ink);
  }

  .external-icon {
    opacity: 0.7;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  .nav-link:hover .external-icon {
    opacity: 1;
    transform: translate(1px, -1px);
  }

  .nav-download-btn {
    box-shadow: 0 2px 12px var(--color-brand-glow);
  }

  /* Mobile responsiveness */
  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }

    .navbar-wrapper {
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }
  }

  @media (max-width: 480px) {
    .brand-text {
      font-size: 1.05rem;
    }

    .logo-mark :global(svg) {
      width: 30px;
      height: 30px;
    }

    .nav-download-btn {
      padding: 0 var(--space-3);
      font-size: 0.8125rem;
    }
  }
</style>
